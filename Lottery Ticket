function bingo(ticket, win){
let miniWins = 0;
  for (const item of ticket) {
    const text = item[0];
    const number = item[1];
    for (let i = 0; i <text.length; i++) {
      if(text.charCodeAt(i) === number) {
        miniWins++;
        break;
      }
    }
  }
  if(miniWins >= win) {
    return "Winner!";
  }
  return "Loser!";
}
